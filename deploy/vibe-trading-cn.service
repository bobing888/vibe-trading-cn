#!/bin/bash
# vibe-trading-cn systemd unit
# 安装路径：/etc/systemd/system/vibe-trading-cn.service
# 启用：systemctl daemon-reload && systemctl enable --now vibe-trading-cn

[Unit]
Description=vibe-trading-cn scheduler (BTC/ETH/SOL trend prediction)
Documentation=https://github.com/bobing888/vibe-trading-cn
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# 运行环境变量（含 API 密钥等敏感信息）
EnvironmentFile=/etc/vibe-trading-cn/secrets.env
# 工作目录
WorkingDirectory=/opt/vibe-trading-cn
# 启动命令（前台阻塞；systemd 负责守护 + 重启）
# 项目用 src/ layout，通过 PYTHONPATH=src 注入模块
ExecStart=/opt/vibe-trading-cn/.venv/bin/python -m vibe_trading_cn.cli_scheduler --interval ${VIBE_TRADING_INTERVAL_SECONDS}
# 优雅停止
ExecStop=/bin/kill -SIGTERM $MAINPID
KillSignal=SIGTERM
TimeoutStopSec=30
# 重启策略
Restart=on-failure
RestartSec=10s
# 资源限制
LimitNOFILE=65536
# 安全：非 root 运行（前提：先创建 vibe-trading 用户和 /opt/vibe-trading-cn 属主）
User=vibe-trading
Group=vibe-trading
# 日志输出到 journald
StandardOutput=journal
StandardError=journal
SyslogIdentifier=vibe-trading-cn
# 环境隔离
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1

# 强化：禁止升级权限 + 限制文件系统
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/vibe-trading-cn
PrivateTmp=true

[Install]
WantedBy=multi-user.target
