# vibe-trading-cn 生产环境变量模板
# 复制到 /etc/vibe-trading-cn/secrets.env 并 chmod 600
# ⚠️ 真实密钥绝不能 commit 到 git

# ─── LLM 配置（PR-12） ───
# 任选一个 provider；不设置 = 走 production_adapter stub（中性结果）
# OpenAI
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Kimi（月之暗面）
KIMI_API_KEY=
KIMI_BASE_URL=https://api.moonshot.cn/v1
KIMI_MODEL=moonshot-v1-8k

# DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# ─── 数据 vendor 配置（PR-13） ───
# CCXT（加密：BTC/ETH/SOL via Binance/OKX/Bybit）
CCXT_EXCHANGE=binance
CCXT_API_KEY=
CCXT_SECRET=

# YFinance（A 股 6 位数字/.SS/.SZ + 美股）
# 不需要 key，但可能被限流

# ─── Scheduler 行为（PR-11） ───
# 调度间隔（秒）；默认 3600 = 1 小时
VIBE_TRADING_INTERVAL_SECONDS=3600

# Decision log 路径
VIBE_TRADING_DECISION_LOG_PATH=/var/lib/vibe-trading-cn/decisions.jsonl

# Scheduler state 路径
VIBE_TRADING_SCHEDULER_STATE_PATH=/var/lib/vibe-trading-cn/scheduler-state.json

# Holding days（结算持有天数）
VIBE_TRADING_HOLDING_DAYS=5

# Benchmark ticker（结算基准）
VIBE_TRADING_BENCHMARK=SPY

# ─── 监控告警（可选） ───
# 健康检查 Webhook（企业微信 / 钉钉 / Slack）
# 留空 = 不发告警
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_TYPE=wechat  # wechat | dingtalk | slack
